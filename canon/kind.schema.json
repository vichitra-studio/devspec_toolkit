{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/canon/kind/1",
  "title": "Canonical Kind Registry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "$ref": "https://specdev.local/schema/core/canon/1#/$defs/semver"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/canon/1#/$defs/entry"
      }
    }
  },
  "required": [
    "registry_version",
    "kind",
    "entries"
  ]
}
