#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MATRIX_OUT="$KIT_ROOT/tools/trace_matrix.json"
export PYTHONPATH="$KIT_ROOT/tools"

echo "==> AI Spec Driven Development toolkit smoke tests"

(
  cd "$KIT_ROOT"
  echo "[1/3] validate example specs"
  python3 -m specdev_tools.cli validate-all example/devspec_kit --repo-root "$KIT_ROOT"

  echo "[2/3] lint example fixtures"
  python3 -m specdev_tools.cli fixtures-lint example/devspec_kit --repo-root "$KIT_ROOT"

  echo "[3/3] build example trace matrix"
  python3 -m specdev_tools.cli matrix example/devspec_kit --repo-root "$KIT_ROOT" --out "$MATRIX_OUT"
)

echo "AI Spec Driven Development toolkit smoke tests completed."
