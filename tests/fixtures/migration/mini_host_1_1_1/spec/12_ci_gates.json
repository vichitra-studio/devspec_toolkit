            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:npm-ci",
            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:npm-run-lint",
            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:npm-run-migrate-env-prod",
            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:npm-run-smoke",
            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:npm-test",
            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:specdev-fixtures-lint-spec",
            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:specdev-governance-check-spec",
            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:specdev-matrix-spec",
            "kind": "command",
            "version": "1.0.0"
        },
        {
            "id": "cn:project:command:specdev-validate-all-spec",
            "kind": "command",
            "version": "1.0.0"
        }
    ]
}
