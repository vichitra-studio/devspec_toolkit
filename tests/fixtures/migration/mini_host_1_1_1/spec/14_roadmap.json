                    ]
                }
            ],
            "milestone_status_reason": "Closed by the desk lead after the two-day fee check",
            "deliverables": [
                {
                    "type": "fr",
                    "id": "fr-late-fee-calc"
                }
            ],
            "fr_refs": [
