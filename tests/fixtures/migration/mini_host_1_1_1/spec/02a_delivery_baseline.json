        },
        "prod": {
            "region": "eu-west-1",
            "log_level": "warn",
            "ghost_port": 2368
        }
    },
    "ci_gates": [
        "lint",
        "unit-tests",
        "schema-validate"
    ],
    "secrets": [
        "DATABASE_URL",
        "TEXTLINE_API_KEY"
    ],
    "trace": [
        {
            "type": "capability",
            "id": "cap-checkout-return"
        }
    ],
    "canonical_refs_used": []
