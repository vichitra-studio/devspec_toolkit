      ["json", "patch", "--id", "gate-go-live-staging-teardown", ".name", "\"Go-live smoke check\""],
      ["json", "patch", "--id", "gate-go-live-staging-teardown", ".realises", "[\"prod\", \"secret-textline-api-key\"]"],
      ["json", "insert", "{spec}/common/host_declarations.json", ".", "{\"release_tag_pattern\": \"^v[0-9]+[.][0-9]+[.][0-9]+$\", \"setup_command\": \"npm ci\"}", "--create-schema", "vc:host-declarations"],
      {"replace": {"path": ".github/workflows/spec_validation.yml", "old": "specdev validate-all spec --repo-root ./devspec_toolkit", "new": "specdev spec-check spec --repo-root ./devspec_toolkit --spec-root ./spec --git-root . --merge"}},
