    {"step": "08", "commands": [
      ["json", "patch", "--id", "ac-waitlist-notify-1", ".scope_reason", "\"The waitlist requirement is deferred to a later phase, so its criteria wait with it.\""],
      ["json", "patch", "--id", "ac-waitlist-notify-1", ".scope", "\"out\""],
