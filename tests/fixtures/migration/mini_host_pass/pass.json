    {"step": "04", "commands": [
      ["json", "patch", "--id", "fr-reserve-tool", ".derives_from", "[\"cap-reserve-tool\"]"],
      ["json", "patch", "--id", "fr-return-tool", ".derives_from", "[\"cap-checkout-return\"]"],
      ["json", "insert", "--id", "fr-reserve-tool", ".acceptance_criteria", "{\"criterion_id\": \"ac-reserve-tool-3\", \"text\": \"A member with a reservation is sent a reminder text the evening before the pickup day\", \"scope\": \"in\"}"],
      ["json", "patch", "--id", "ac-late-fee-calc-2", ".text", "\"A loan returned on its due date, or part of a day late, owes nothing\""],
      ["json", "patch", "--id", "fr-reserve-tool", ".postconditions", "[\"The tool is held for the member until the desk closes: 18:00 on weekdays, 14:00 on Saturdays\"]"],
      ["attest", "--step", "04", "--yes"]
    ]},
    {"step": "05", "commands": [
      ["json", "patch", "--id", "err-query-too-short", ".derives_from", "[\"ac-catalog-search-1\"]"],
      ["json", "patch", "--id", "err-tool-already-reserved", ".derives_from", "[\"ac-reserve-tool-1\"]"],
      ["json", "patch", "--id", "err-reservation-limit", ".derives_from", "[\"ac-reserve-tool-2\"]"],
      ["json", "patch", "--id", "err-reservation-not-found", ".derives_from", "[\"ac-reserve-tool-1\"]"],
