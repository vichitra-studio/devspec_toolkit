      ["json", "patch", "--id", "tc-post-reservations-answers-201-and-409-as", ".refines", "[\"ac-reserve-tool-1\", \"err-tool-already-reserved\"]"],
      ["json", "patch", "--id", "tc-post-reservations-answers-201-and-409-as", ".verified_by", "[\"fix-reserve-twice\"]"],
      ["json", "insert", "--id", "task-reserve-endpoint", ".acceptance_criteria", "{\"criterion_id\": \"tc-delete-reservations-answers-204-and-404\", \"text\": \"DELETE /reservations/{id} answers 204 for an open reservation and 404 for an unknown one\", \"refines\": [\"api-reserve-cancel\", \"err-reservation-not-found\"], \"verified_by\": [\"fix-reserve-cancel\"]}"],
