{
  "$comment": "The scripted judgement pass of the mini host (WI-M10-15b). Every answer is INVENTED about the invented host Lantern Lending. A step is a list of commands in the order a person runs them; {spec} is the spec folder of the host; an object is an operation on a file of the host outside spec/ (write_file, replace, commit).",
  "steps": [
    {"step": "00", "commands": [
      ["json", "patch", "--id", "scope-browse-the-tool-catalog-and-see-what-is-on-the", ".derives_from", "[\"need-know-before-walking-over-whether-a-tool-is-on\", \"seed-decision-clarifications\"]"],
      ["json", "patch", "--id", "scope-reserve-a-tool-for-a-pickup-day", ".derives_from", "[\"need-know-before-walking-over-whether-a-tool-is-on\", \"seed-decision-clarifications\"]"],
