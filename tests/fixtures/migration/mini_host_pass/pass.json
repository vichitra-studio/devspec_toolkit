      ["json", "patch", "--id", "cap-late-fees", ".derives_from", "[\"m-overdue-share\", \"scope-check-tools-out-and-back-in-at-the-desk\"]"],
      ["json", "patch", "--id", "cap-repair-queue", ".derives_from", "[\"desk-volunteers\"]"],
      ["json", "patch", "--id", "cap-repair-queue", ".scope_reason", "\"The repair table runs on the volunteers' own roster for now; a queue in the system waits for a later release.\""],
      ["json", "patch", "--id", "cap-checkout-return", ".assumes", "[\"asm-the-library-keeps-one-desk-computer-with-a\"]"],
