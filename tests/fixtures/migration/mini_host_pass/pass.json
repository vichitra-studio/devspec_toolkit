      ["json", "patch", "--id", "ac-waitlist-notify-2", ".scope", "\"out\""],
      ["json", "patch", "--id", "fix-search-returns-matches", ".verifies", "[\"api-catalog-search\", \"ac-catalog-search-1\", \"ac-catalog-search-2\"]"],
      ["json", "patch", "--id", "fix-reserve-happy", ".verifies", "[\"api-reserve-create\", \"inv-reservation-window\"]"],
      ["json", "patch", "--id", "fix-reserve-twice", ".verifies", "[\"api-reserve-create\", \"ac-reserve-tool-1\"]"],
      ["json", "patch", "--id", "fix-checkout-conflict", ".verifies", "[\"api-checkout-create\", \"inv-no-double-checkout\", \"ac-checkout-tool-1\"]"],
      ["json", "patch", "--id", "fix-return-closes-loan", ".verifies", "[\"api-return-create\", \"ac-return-tool-1\"]"],
      ["json", "patch", "--id", "fix-late-fee-two-days", ".verifies", "[\"nfr-fee-accuracy\", \"ac-late-fee-calc-1\"]"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-reserve-limit\", \"description\": \"Given a member with three open reservations, when a fourth is made, it is refused\", \"mode\": \"e2e\", \"input\": {\"member\": \"m-17\", \"open_reservations\": 3}, \"expected\": {\"status\": 409, \"error\": \"reservation-limit\"}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"ac-reserve-tool-2\"]}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-reserve-cancel\", \"description\": \"Given an open reservation, when it is cancelled, the hold is released\", \"mode\": \"e2e\", \"input\": {\"reservation_id\": \"res-9\"}, \"expected\": {\"status\": 204}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"api-reserve-cancel\"]}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-checkout-due-date\", \"description\": \"Given a tool on the shelf, when it is checked out on a Monday, it is due the next Monday\", \"mode\": \"unit\", \"input\": {\"checkout_day\": \"2026-04-06\"}, \"expected\": {\"due_day\": \"2026-04-13\"}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"ac-checkout-tool-2\"]}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-return-without-loan\", \"description\": \"Given a tool with no open loan, when a return is recorded, it is refused\", \"mode\": \"contract\", \"input\": {\"id\": \"loan-none\"}, \"expected\": {\"status\": 404}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"ac-return-tool-2\"]}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-late-fee-on-time\", \"description\": \"Given a loan returned on its due date, when the fee is computed, nothing is owed\", \"mode\": \"unit\", \"input\": {\"days_late\": 0}, \"expected\": {\"fee_cents\": 0}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"ac-late-fee-calc-2\"]}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-fee-get-unknown\", \"description\": \"Given a loan with no recorded fee, when the fee is read, the answer is fee-not-found\", \"mode\": \"contract\", \"input\": {\"id\": \"loan-none\"}, \"expected\": {\"status\": 404, \"error\": \"fee-not-found\"}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"api-fee-get\", \"inv-fee-nonnegative\"]}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-search-latency\", \"description\": \"Given the 2,000 tool seed data, when 50 searches run, the p95 stays under 400 ms\", \"mode\": \"contract\", \"input\": {\"queries\": 50}, \"expected\": {\"p95_ms_max\": 400}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"nfr-search-latency\"]}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-checkout-latency\", \"description\": \"Given the staging stack, when 50 checkouts run, the p95 stays under 800 ms\", \"mode\": \"e2e\", \"input\": {\"checkouts\": 50}, \"expected\": {\"p95_ms_max\": 800}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"nfr-checkout-latency\"]}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-desk-uptime\", \"description\": \"Given a desk week, when the uptime monitor report is read, availability is at least 99 percent\", \"mode\": \"manual\", \"input\": {\"report\": \"weekly uptime\"}, \"expected\": {\"availability_min\": 99}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"nfr-desk-availability\"], \"manual_reason\": \"Availability is read from the hosting provider's uptime monitor; no command can run it.\"}"],
      ["json", "insert", "--step", "08", ".fixtures", "{\"fixture_id\": \"fix-reserve-reminder\", \"description\": \"Given a reservation for tomorrow, when the evening job runs, a reminder text reaches the test phone\", \"mode\": \"manual\", \"input\": {\"reservation\": \"res-9\", \"phone\": \"test-phone\"}, \"expected\": {\"text_received\": true}, \"tag_ref\": {\"id\": \"cn:core:tag:critical-path\", \"kind\": \"tag\", \"version\": \"1.0.0\"}, \"verifies\": [\"ac-reserve-tool-3\", \"inv-reservation-window\"], \"manual_reason\": \"The reminder goes through the Textline sandbox to a real handset; a person reads the phone.\"}"],
      ["attest", "--step", "08", "--yes"]
    ]},
