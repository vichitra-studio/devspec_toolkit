      ["json", "patch", "--id", "scope-online-payment-of-late-fees", ".scope_reason", "\"Members pay a late fee in person at the desk; no payment provider is contracted for the first release.\""],
      ["json", "patch", "--id", "scope-online-payment-of-late-fees", ".derives_from", "[\"seed-lending-overview\", \"seed-decision-clarifications\"]"],
      ["json", "patch", "--id", "scope-tool-donation-intake", ".scope_reason", "\"Donated tools are shelved by the volunteers without a record in the system in the first release.\""],
      ["json", "patch", "--id", "scope-tool-donation-intake", ".derives_from", "[\"seed-lending-overview\", \"seed-decision-clarifications\"]"],
      ["json", "patch", "--id", "scope-scheduling-of-repair-table-volunteers", ".scope_reason", "\"The repair table roster stays on the volunteers' own sheet; the system never schedules people.\""],
      ["json", "patch", "--id", "scope-scheduling-of-repair-table-volunteers", ".derives_from", "[\"seed-lending-overview\", \"seed-volunteer-roster\"]"],
      ["json", "patch", "--id", "asm-the-library-keeps-one-desk-computer-with-a", ".derives_from", "[\"seed-lending-overview\"]"],
      ["json", "patch", "--id", "asm-members-have-a-phone-number-we-can-text", ".derives_from", "[\"seed-lending-overview\"]"],
      ["json", "patch", "--id", "risk-volunteer-availability-at-the-cafe-lantern", ".derives_from", "[\"seed-volunteer-roster\"]"],
      ["json", "patch", "--id", "risk-the-hosting-plan-may-not-allow-a-second", ".derives_from", "[\"seed-lending-overview\"]"],
      ["json", "patch", "--id", "need-check-a-tool-out-in-under-a-minute", ".derives_from", "[\"seed-lending-overview\"]"],
      ["json", "patch", "--id", "need-see-at-a-glance-who-holds-an-overdue-tool", ".derives_from", "[\"seed-lending-overview\"]"],
      ["json", "patch", "--id", "need-know-before-walking-over-whether-a-tool-is-on", ".derives_from", "[\"seed-lending-overview\"]"],
      ["json", "patch", "--id", "member-borrowers", ".derives_from", "[\"seed-lending-overview\"]"],
      ["json", "patch", "--id", "desk-volunteers", ".derives_from", "[\"seed-lending-overview\"]"],
      ["json", "patch", "--id", "m-checkout-time", ".derives_from", "[\"need-check-a-tool-out-in-under-a-minute\"]"],
      ["json", "patch", "--id", "m-overdue-share", ".derives_from", "[\"need-see-at-a-glance-who-holds-an-overdue-tool\"]"],
      ["json", "insert", "{spec}/common/seed_manifest.json", ".step_requirements[\"00\"]", "\"seed-volunteer-roster\""],
      ["attest", "--step", "00", "--yes"]
    ]},
    {"step": "01", "commands": [
      ["json", "patch", "--id", "cap-browse-catalog", ".derives_from", "[\"scope-browse-the-tool-catalog-and-see-what-is-on-the\", \"member-borrowers\"]"],
