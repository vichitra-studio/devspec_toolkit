      ["attest", "--step", "01", "--yes"]
    ]},
    {"step": "02", "commands": [
      ["json", "patch", "--id", "lending-service", ".derives_from", "[\"cap-checkout-return\", \"cap-late-fees\", \"cap-reserve-tool\"]"],
      ["json", "patch", "--id", "textline-sms", ".pin", "\"v2\""],
      ["json", "patch", "--id", "textline-sms", ".derives_from", "[\"seed-hosting-plan\"]"],
      ["json", "patch", "--id", "conn-lending-service-textline-sms", ".connects_to", "[\"textline-sms\"]"],
      ["json", "patch", "--id", "textline-sms", ".rationale", "\"Deliver pickup reminders by text message; Report delivery failures; Accept message batches. The Textline plan allows 500 texts a month, which covers the expected reservations.\""],
      ["attest", "--step", "02", "--yes"]
    ]},
    {"step": "02a", "commands": [
      ["json", "patch", "--id", "dev", ".derives_from", "[\"seed-hosting-plan\"]"],
