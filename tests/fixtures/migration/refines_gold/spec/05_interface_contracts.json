{
    "$schema": "vc:05-interface-contracts",
    "id": "interface-contracts-seed-library",
    "owner": "api",
    "created_at": "2026-11-15T00:00:00Z",
    "apis": [
        {
            "api_id": "api-borrow-packet",
            "name": "borrow packet",
            "scope": "in",
            "derives_from": [
                "fr-borrow-packet"
            ],
            "errors": [
                {
                    "error_id": "err-borrow-limit-reached",
                    "code": "limit-reached",
                    "severity": "error",
                    "message": "HTTP 409: the member already holds the maximum number of packets.",
                    "scope": "in"
                }
            ]
        },
        {
            "api_id": "api-packet-photo-upload",
            "name": "packet photo upload",
            "scope": "in",
            "derives_from": [
                "fr-packet-photos"
            ],
            "errors": [
                {
                    "error_id": "err-photo-too-large",
                    "code": "photo-too-large",
                    "severity": "error",
                    "message": "HTTP 413: the photo is larger than the five megabyte limit.",
                    "scope": "in"
                }
            ]
        }
    ]
}
