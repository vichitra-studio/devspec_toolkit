{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vc:extras-sample-record",
  "title": "Sample record (fixture)",
  "description": "A record-role node in a registered non-step schema; x-node.files makes the schema a host.",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "x-node": {
        "kind": "sample-record",
        "id": "record_id",
        "role": "record",
        "contract": ["note"],
        "step": "04",
        "files": ["extras/sample/*.json"]
      },
      "items": {
        "type": "object",
        "properties": {
          "record_id": {"$ref": "vc:core:atoms#kebabId"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
