{
  "$schema": "vc:06-invariants",
  "id": "invariants-password-reset",
  "owner": "engineering",
  "created_at": "2026-11-15T00:00:00Z",
  "rules": [
    {
      "inv_id": "inv-reset-token-single-use",
      "language": "text",
      "severity": "error",
      "enforcement_point": "service",
      "description": "The system ensures that a reset token changes a password at most once.",
      "expression": "redeem(token) succeeds only if token.used_at == null; a successful redeem sets token.used_at",
      "constrains": [
        "fr-password-reset",
        "api-password-reset-confirm",
        "identity-service",
        "err-password-reset-confirm-token-expired"
      ],
      "policy_ref": {
        "id": "cn:core:policy:spec-first",
        "kind": "policy",
        "version": "1.0.0"
      }
    }
  ],
  "canonical_refs_used": [
    {
      "id": "cn:core:policy:spec-first",
      "kind": "policy",
      "version": "^1.0.0"
    }
  ]
}
