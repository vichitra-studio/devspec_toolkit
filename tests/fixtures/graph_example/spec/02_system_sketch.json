{
  "$schema": "vc:02-system-sketch",
  "id": "system-sketch-password-reset",
  "owner": "engineering",
  "created_at": "2026-11-15T00:00:00Z",
  "components": [
    {
      "component_id": "identity-service",
      "type": "service",
      "owner": "engineering",
      "responsibilities": [
        "Issues and redeems password reset tokens",
        "Stores password hashes",
        "Serves the password reset endpoints"
      ],
      "derives_from": [
        "cap-account-recovery"
      ]
    }
  ],
  "connections": [
    {
      "connection_id": "conn-identity-to-mailrelay",
      "derives_from": [
        "identity-service"
      ],
      "connects_to": [
        "tp-mailrelay"
      ],
      "protocol": "http",
      "trust_boundary": "partner",
      "auth": "key",
      "rate_limit": {
        "rps": 50,
        "burst": 100,
        "window_s": 60,
        "scope": "client"
      }
    }
  ],
  "third_parties": [
    {
      "third_party_id": "tp-argon2",
      "name": "argon2 (npm package)",
      "pin": "0.41.1",
      "derives_from": [
        "seed-accounts"
      ]
    },
    {
      "third_party_id": "tp-mailrelay",
      "name": "MailRelay transactional email API",
      "pin": "api-v3",
      "derives_from": [
        "seed-accounts"
      ]
    }
  ],
  "canonical_refs_used": []
}
