{
  "$schema": "vc:10-governance",
  "id": "governance-core",
  "owner": "system",
  "created_at": "2025-01-01T00:00:00Z",
  "versioning": "semver",
  "commit_message_rules": {
    "require_spec_ids": true,
    "pattern": "^(feat|fix|chore|docs)\\(.+\\): .+( \\[([a-z0-9-]+)\\])?$",
    "error_message": "Must follow conventional commits.",
    "id_pattern_ref": {
      "id": "cn:core:id_pattern:conventional-commit",
      "kind": "id_pattern",
      "version": "1.0.0"
    }
  },
  "policy_ref": {
    "id": "cn:core:policy:spec-first",
    "kind": "policy",
    "version": "1.0.0"
  },
  "command_ref": {
    "id": "cn:core:command:governance-check",
    "kind": "command",
    "version": "1.0.0"
  },
  "canonical_refs_used": [
    {
      "id": "cn:core:id_pattern:conventional-commit",
      "kind": "id_pattern",
      "version": "1.0.0"
    },
    {
      "id": "cn:core:policy:spec-first",
      "kind": "policy",
      "version": "1.0.0"
    },
    {
      "id": "cn:core:command:governance-check",
      "kind": "command",
      "version": "1.0.0"
    }
  ],
  "rules": [
    {
      "rule_id": "rule-spec-check-on-every-pr",
      "text": "Every pull request passes the spec merge check.",
      "derives_from": [
        "risk-spec-drift"
      ],
      "cli_command": "spec-check"
    },
    {
      "rule_id": "rule-security-review-of-token-handling",
      "text": "A person reviews every change to token handling before release.",
      "derives_from": [
        "risk-spec-drift"
      ],
      "enforcer": "review"
    }
  ]
}
