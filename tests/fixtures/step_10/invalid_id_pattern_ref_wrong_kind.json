{
  "$schema": "vc:10-governance",
  "id": "governance-core",
  "owner": "system",
  "created_at": "2025-01-01T00:00:00Z",
  "spec_first_policy": true,
  "versioning": "semver",
  "pr_rules": [
    "lint",
    "test",
    "audit"
  ],
  "commit_message_rules": {
    "require_spec_ids": true,
    "pattern": "^(feat|fix|chore|docs)\\(.+\\): .+( \\[([a-z0-9-]+)\\])?$",
    "error_message": "Must follow conventional commits.",
    "id_pattern_ref": {
      "id": "cn:core:id_pattern:conventional-commit",
      "kind": "term",
      "version": "1.0.0"
    }
  },
  "reviewers": [
    "alice",
    "bob"
  ],
  "trace": [
    {
      "type": "doc",
      "id": "charter"
    }
  ],
  "policy_ref": {
    "id": "cn:core:policy:spec-first",
    "kind": "policy",
    "version": "1.0.0"
  },
  "command_ref": {
    "id": "cn:core:command:governance-check",
    "kind": "command",
    "version": "1.0.0"
  },
  "canonical_refs_used": [
    {
      "id": "cn:core:policy:spec-first",
      "kind": "policy",
      "version": "1.0.0"
    },
    {
      "id": "cn:core:command:governance-check",
      "kind": "command",
      "version": "1.0.0"
    }
  ]
}
