{
  "id": "system-sketch-standard",
  "owner": "api",
  "created_at": "2025-01-01T00:00:00Z",
  "components": [
    {
      "component_id": "user-service",
      "type": "service",
      "responsibilities": [
        "Create user accounts",
        "Update user profiles",
        "Serve account queries"
      ],
      "owner": "api",
      "tags": [
        "critical-path",
        "stateless"
      ],
      "derives_from": [
        "capability-user-profile"
      ]
    },
    {
      "component_id": "auth-service",
      "type": "service",
      "responsibilities": [
        "Authenticate credentials",
        "Issue access tokens",
        "Revoke active sessions"
      ],
      "owner": "api",
      "tags": [
        "supporting",
        "stateless"
      ],
      "derives_from": [
        "capability-user-auth"
      ]
    },
    {
      "component_id": "billing-service",
      "type": "service",
      "responsibilities": [
        "Create payment intents",
        "Capture authorized payments",
        "Record payment receipts"
      ],
      "owner": "api",
      "tags": [
        "critical-path",
        "stateful"
      ],
      "derives_from": [
        "capability-payment-processing"
      ]
    },
    {
      "component_id": "user-db",
      "type": "db",
      "responsibilities": [
        "Persist user records",
        "Store profile attributes",
        "Index account lookup keys"
      ],
      "owner": "data",
      "tags": [
        "critical-path",
        "stateful"
      ],
      "derives_from": [
        "capability-user-profile"
      ]
    }
  ],
  "connections": [
    {
      "connection_id": "user-service-to-auth-service",
      "derives_from": [
        "user-service"
      ],
      "connects_to": [
        "auth-service"
      ],
      "protocol": "http",
      "trust_boundary": "internal",
      "rate_limit": {
        "rps": 100,
        "scope": "client"
      }
    },
    {
      "connection_id": "user-service-to-user-db",
      "derives_from": [
        "user-service"
      ],
      "connects_to": [
        "user-db"
      ],
      "protocol": "db",
      "trust_boundary": "internal"
    },
    {
      "connection_id": "user-service-to-billing-service",
      "derives_from": [
        "user-service"
      ],
      "connects_to": [
        "billing-service"
      ],
      "protocol": "event",
      "trust_boundary": "internal",
      "reliability": "at-least-once"
    }
  ],
  "tech_stack": {
    "languages": [
      {
        "name": "TypeScript",
        "version": "5.4",
        "rationale": "Type safety for service development"
      }
    ],
    "frameworks": [
      {
        "name": "Express",
        "version": "^4.19",
        "rationale": "HTTP framework for user-service and auth-service"
      }
    ],
    "infrastructure": [
      {
        "name": "PostgreSQL",
        "version": "16",
        "rationale": "Primary data store for user-db component"
      }
    ],
    "tools": [
      {
        "name": "ESLint",
        "version": "^9.0",
        "rationale": "Linting for TypeScript codebase"
      }
    ]
  },
  "canonical_refs_used": []
}
