{
  "version": "1.0.0",
  "_notes": {
    "status_write_exemptions": "Step 16c writes milestones[].status='done' to Steps 09/14 on verified milestones. Without this exemption, file-level change detection triggers E550 requiring full downstream replay, creating an infinite cycle.",
    "downstream_consumers": "Records which steps actively consume each step's output. Read by 'specdev prompt-context'. NOT used by the forward-replay check (which uses positional ordering in 'steps').",
    "step_metadata": "Per-step declarative metadata. required_spec_inputs is the inverse of downstream_consumers (producers that feed into this step) \u2014 kept redundant for O(1) lookup and consistency validation."
  },
  "policy": {
    "mode": "strict_waterfall",
    "allow_self_dependency": false,
    "allow_forward_dependency": false,
    "require_full_forward_replay_on_change": true,
