{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/04_fr_list.schema.json",
  "title": "04_fr_list",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
    },
    "owner": {
      "$ref": "https://specdev.local/schema/core/atoms/1#owner"
    },
    "created_at": {
      "$ref": "https://specdev.local/schema/core/atoms/1#timestamp"
    },
    "spec_refs_ingested": {
      "$ref": "https://specdev.local/schema/core/collections/1#specRefsIngestedArray"
    },
    "seed_refs": {
      "$ref": "https://specdev.local/schema/core/collections/1#seedRefArray"
    },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fr_id": {
            "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
          },
          "statement": {
            "type": "string",
            "minLength": 20
          },
          "rationale": {
            "type": "string"
          },
          "preconditions": {
            "$ref": "https://specdev.local/schema/core/collections/1#stringArray"
          },
          "postconditions": {
            "$ref": "https://specdev.local/schema/core/collections/1#stringArray"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "criterion_id": {
                  "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
                },
                "text": {
                  "type": "string",
                  "minLength": 15
                },
                "fixture_ref": {
                  "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
                }
              },
              "required": [
                "criterion_id",
                "text"
              ]
            }
          },
          "trace": {
            "type": "array",
            "items": {
              "$ref": "https://specdev.local/schema/core/collections/1#traceRef"
            }
          },
          "capability_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          },
          "action_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          },
          "entity_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          },
          "status_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          }
        },
        "required": [
          "fr_id",
          "statement",
          "acceptance_criteria",
          "trace",
          "capability_ref"
        ]
      }
    },
    "generation_quality": {
      "$ref": "https://specdev.local/schema/core/collections/1#generationQuality"
    },
    "canonical_refs_used": {
      "$ref": "https://specdev.local/schema/core/collections/1#canonicalRefArray"
    },
    "canonical_proposals": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#canonicalProposal"
      },
      "default": []
    },
    "canonical_conflicts": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#canonicalConflict"
      },
      "default": []
    },
    "coverage_gaps": {
      "$ref": "https://specdev.local/schema/core/collections/1#coverageGapsArray"
    },
    "_migration_notes": {
      "type": "string",
      "description": "Optional migration notes added during schema version upgrades."
    }
  },
  "required": [
    "id",
    "owner",
    "created_at",
    "seed_refs",
    "spec_refs_ingested",
    "functional_requirements",
    "generation_quality",
    "canonical_refs_used",
    "canonical_proposals",
    "canonical_conflicts",
    "coverage_gaps"
  ]
}
