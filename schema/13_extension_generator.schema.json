{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vc:13-extension-generator",
  "title": "13_extension_generator",
  "allOf": [
    {
      "$ref": "vc:core:step-base",
      "description": "Inherits shared step-base properties ($schema, id, owner, created_at, canonical_refs_used)."
    },
    {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "array",
          "description": "List of extension specs to generate for domain-specific concerns.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extension_id": {
                "type": "string",
                "pattern": "^ext-[0-9]{2}-[a-z0-9-]+$",
                "description": "Unique ID for the extension (e.g. 'ext-01-database')"
              },
              "title": {
                "type": "string",
                "description": "Human-readable title of the extension."
              },
              "file_name": {
                "type": "string",
                "pattern": "^ext_[0-9]{2}_[a-z0-9_]+\\.json$",
                "description": "Must follow pattern 'ext_[0-9]{2}_[topic].json'"
              },
              "area_of_concern": {
                "type": "string",
                "description": "Domain (e.g. Data, Security, AI)"
              },
              "justification": {
                "type": "string",
                "description": "Rationale for why this extension is needed."
              },
              "required_schema_sections": {
                "type": "array",
                "description": "Schema sections that the extension must define.",
                "items": {
                  "type": "string",
                  "description": "A schema section name that the extension must define."
                }
              },
              "schema_design_guidelines": {
                "type": "string",
                "description": "Guidelines for designing the extension's JSON schema."
              },
              "tag_ref": {
                "$ref": "vc:core:collections#canonicalRef",
                "description": "Canonical reference for the tag associated with this extension."
              },
              "policy_ref": {
                "$ref": "vc:core:collections#canonicalRef",
                "description": "Canonical reference for the governance policy governing this extension."
              },
              "id_pattern_ref": {
                "$ref": "vc:core:collections#canonicalRef",
                "description": "Canonical reference for the ID pattern used in this extension."
              },
              "governance_label_ref": {
                "$ref": "vc:core:collections#canonicalRef",
                "description": "Canonical reference for the governance label assigned to this extension."
              }
            },
            "required": [
              "extension_id",
              "title",
              "file_name",
              "area_of_concern",
              "required_schema_sections",
              "governance_label_ref"
            ],
            "description": "A single extension spec definition with ID, title, and schema requirements."
          }
        }
      },
      "required": [
        "extensions"
      ],
      "description": "Step-specific properties for 13_extension_generator."
    }
  ],
  "unevaluatedProperties": false
}
