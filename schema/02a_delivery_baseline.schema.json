{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/02a_delivery_baseline.schema.json",
  "title": "02a_delivery_baseline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
    },
    "owner": {
      "$ref": "https://specdev.local/schema/core/atoms/1#owner"
    },
    "created_at": {
      "$ref": "https://specdev.local/schema/core/atoms/1#timestamp"
    },
    "spec_refs_ingested": {
      "$ref": "https://specdev.local/schema/core/collections/1#specRefsIngestedArray"
    },
    "seed_refs": {
      "$ref": "https://specdev.local/schema/core/collections/1#seedRefArray"
    },
    "trace": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#traceRef"
      }
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://specdev.local/schema/core/collections/1#environmentName"
      },
      "additionalProperties": {
        "$ref": "https://specdev.local/schema/core/collections/1#environmentConfig"
      },
      "required": [
        "dev",
        "ci",
        "staging",
        "prod"
      ],
      "minProperties": 4
    },
    "ci_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "secrets": {
      "$ref": "https://specdev.local/schema/core/collections/1#stringArray"
    },
    "compliance": {
      "$ref": "https://specdev.local/schema/core/collections/1#stringArray"
    },
    "generation_quality": {
      "$ref": "https://specdev.local/schema/core/collections/1#generationQuality"
    },
    "canonical_refs_used": {
      "$ref": "https://specdev.local/schema/core/collections/1#canonicalRefArray"
    },
    "canonical_proposals": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#canonicalProposal"
      },
      "default": []
    },
    "canonical_conflicts": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#canonicalConflict"
      },
      "default": []
    },
    "environment_ref": {
      "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
    },
    "command_ref": {
      "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
    },
    "policy_ref": {
      "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
    },
    "coverage_gaps": {
      "$ref": "https://specdev.local/schema/core/collections/1#coverageGapsArray"
    },
    "_migration_notes": {
      "type": "string",
      "description": "Optional migration notes added during schema version upgrades."
    }
  },
  "required": [
    "id",
    "owner",
    "created_at",
    "seed_refs",
    "spec_refs_ingested",
    "environments",
    "ci_gates",
    "generation_quality",
    "canonical_refs_used",
    "canonical_proposals",
    "canonical_conflicts",
    "coverage_gaps"
  ]
}
