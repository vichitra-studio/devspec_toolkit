{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/05_interface_contracts.schema.json",
  "title": "05_interface_contracts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
    },
    "owner": {
      "$ref": "https://specdev.local/schema/core/atoms/1#owner"
    },
    "created_at": {
      "$ref": "https://specdev.local/schema/core/atoms/1#timestamp"
    },
    "spec_refs_ingested": {
      "$ref": "https://specdev.local/schema/core/collections/1#specRefsIngestedArray"
    },
    "seed_refs": {
      "$ref": "https://specdev.local/schema/core/collections/1#seedRefArray"
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "api_id": {
            "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^v\\d+(?:\\.\\d+)*$"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "http",
              "grpc",
              "ws",
              "mqtt"
            ]
          },
          "route": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "request_schema_ref": {
            "type": "string"
          },
          "response_schema_ref": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "https://specdev.local/schema/core/errors/1#errorState"
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "in": {
                  "type": "string",
                  "enum": [
                    "query",
                    "path",
                    "header"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "schema": {
                  "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
                }
              },
              "required": [
                "name",
                "in",
                "required"
              ]
            }
          },
          "example_refs": {
            "$ref": "https://specdev.local/schema/core/collections/1#stringArray"
          },
          "security": {
            "type": "string",
            "enum": [
              "none",
              "api-key",
              "oauth2",
              "jwt",
              "mTLS"
            ]
          },
          "owner": {
            "$ref": "https://specdev.local/schema/core/atoms/1#owner"
          },
          "trace": {
            "type": "array",
            "items": {
              "$ref": "https://specdev.local/schema/core/collections/1#traceRef"
            }
          },
          "interface_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          },
          "event_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          },
          "entity_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          },
          "policy_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          },
          "enum_provenance": {
            "type": "object",
            "additionalProperties": false,
            "description": "Provenance tracking for externally-sourced enums in this API.",
            "properties": {
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "source_date": {
                "type": "string",
                "format": "date"
              },
              "resolved_version": {
                "type": "string"
              },
              "resolved_at": {
                "$ref": "https://specdev.local/schema/core/atoms/1#timestamp"
              },
              "resolver": {
                "type": "string",
                "description": "Tool or person that resolved the enum values."
              }
            },
            "required": [
              "source_url",
              "source_date",
              "resolved_at"
            ]
          }
        },
        "required": [
          "api_id",
          "name",
          "version",
          "protocol",
          "owner",
          "interface_ref"
        ]
      }
    },
    "generation_quality": {
      "$ref": "https://specdev.local/schema/core/collections/1#generationQuality"
    },
    "canonical_refs_used": {
      "$ref": "https://specdev.local/schema/core/collections/1#canonicalRefArray"
    },
    "canonical_proposals": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#canonicalProposal"
      },
      "default": []
    },
    "canonical_conflicts": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#canonicalConflict"
      },
      "default": []
    },
    "coverage_gaps": {
      "$ref": "https://specdev.local/schema/core/collections/1#coverageGapsArray"
    },
    "_migration_notes": {
      "type": "string",
      "description": "Optional migration notes added during schema version upgrades."
    }
  },
  "required": [
    "id",
    "owner",
    "created_at",
    "seed_refs",
    "spec_refs_ingested",
    "apis",
    "generation_quality",
    "canonical_refs_used",
    "canonical_proposals",
    "canonical_conflicts",
    "coverage_gaps"
  ]
}
