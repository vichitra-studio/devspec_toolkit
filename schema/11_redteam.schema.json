{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/11_redteam.schema.json",
  "title": "11_redteam",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
    },
    "owner": {
      "$ref": "https://specdev.local/schema/core/atoms/1#owner"
    },
    "created_at": {
      "$ref": "https://specdev.local/schema/core/atoms/1#timestamp"
    },
    "spec_refs_ingested": {
      "$ref": "https://specdev.local/schema/core/collections/1#specRefsIngestedArray"
    },
    "seed_refs": {
      "$ref": "https://specdev.local/schema/core/collections/1#seedRefArray"
    },
    "trace": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#traceRef"
      }
    },
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "threat_id": {
            "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
          },
          "description": {
            "type": "string"
          },
          "vector": {
            "type": "string"
          },
          "target_ids": {
            "type": "array",
            "items": {
              "$ref": "https://specdev.local/schema/core/collections/1#traceRef"
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "authn",
              "authz",
              "business_logic",
              "transport",
              "data_privacy"
            ]
          },
          "mitigations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "fr",
                    "api",
                    "nfr",
                    "inv",
                    "fixture",
                    "doc",
                    "capability"
                  ]
                },
                "id": {
                  "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "id"
              ]
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "risk_category_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          },
          "policy_ref": {
            "$ref": "https://specdev.local/schema/core/collections/1#canonicalRef"
          }
        },
        "required": [
          "threat_id",
          "description",
          "severity",
          "category",
          "target_ids",
          "mitigations",
          "risk_category_ref"
        ]
      }
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
          },
          "description": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "description"
        ]
      }
    },
    "generation_quality": {
      "$ref": "https://specdev.local/schema/core/collections/1#generationQuality"
    },
    "canonical_refs_used": {
      "$ref": "https://specdev.local/schema/core/collections/1#canonicalRefArray"
    },
    "canonical_proposals": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#canonicalProposal"
      },
      "default": []
    },
    "canonical_conflicts": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#canonicalConflict"
      },
      "default": []
    },
    "coverage_gaps": {
      "$ref": "https://specdev.local/schema/core/collections/1#coverageGapsArray"
    },
    "_migration_notes": {
      "type": "string",
      "description": "Optional migration notes added during schema version upgrades."
    }
  },
  "required": [
    "id",
    "owner",
    "created_at",
    "seed_refs",
    "spec_refs_ingested",
    "threats",
    "generation_quality",
    "canonical_refs_used",
    "canonical_proposals",
    "canonical_conflicts",
    "coverage_gaps"
  ]
}
