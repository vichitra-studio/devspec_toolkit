{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/trinity/utility_call.schema.json",
  "title": "Trinity Utility Call Payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "Researcher",
        "ToolUser",
        "Summarizer",
        "Auditor"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "required_outputs"
      ]
    }
  },
  "required": [
    "role",
    "objective",
    "input"
  ]
}
