{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/trinity/utility_result.schema.json",
  "title": "Trinity Utility Result Payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "questions",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "required": [
    "status",
    "summary"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "questions"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "open_questions"
        ],
        "properties": {
          "open_questions": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "errors"
            ],
            "properties": {
              "errors": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "findings"
            ],
            "properties": {
              "findings": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  ]
}
