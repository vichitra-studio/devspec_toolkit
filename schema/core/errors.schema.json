{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/core/errors/1",
  "title": "Error Shapes",
  "$defs": {
    "errorState": {
      "$anchor": "errorState",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error",
            "fatal"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}