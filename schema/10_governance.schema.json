{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdev.local/schema/10_governance.schema.json",
  "title": "10_governance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://specdev.local/schema/core/atoms/1#kebabId"
    },
    "owner": {
      "$ref": "https://specdev.local/schema/core/atoms/1#owner"
    },
    "created_at": {
      "$ref": "https://specdev.local/schema/core/atoms/1#timestamp"
    },
    "spec_refs_ingested": {
      "$ref": "https://specdev.local/schema/core/collections/1#specRefsIngestedArray"
    },
    "seed_refs": {
      "$ref": "https://specdev.local/schema/core/collections/1#seedRefArray"
    },
    "versioning": {
      "type": "string"
    },
    "pr_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "validate",
          "validate-all",
          "matrix",
          "fixtures-lint",
          "invariants-check",
          "governance-check",
          "seed-lint",
          "docs-lint",
          "test",
          "build",
          "lint",
          "format",
          "audit",
          "security"
        ]
      },
      "uniqueItems": true
    },
    "spec_first_policy": {
      "type": "boolean"
    },
    "commit_message_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_spec_ids": {
          "type": "boolean"
        },
        "pattern": {
          "type": "string"
        },
        "id_pattern_ref": {
          "$ref": "https://specdev.local/schema/core/collections/1#/$defs/canonicalRef"
        },
        "error_message": {
          "type": "string",
          "description": "Human readable guidance. MUST list allowed types/values if a specific set is required."
        }
      },
      "required": [
        "require_spec_ids"
      ]
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_metadata": {
          "$ref": "https://specdev.local/schema/core/collections/1#stringArray"
        },
        "evidence_source_by_phase": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dev": {
              "type": "string"
            },
            "staging": {
              "type": "string"
            },
            "prod": {
              "type": "string"
            }
          },
          "required": [
            "dev",
            "staging",
            "prod"
          ]
        }
      },
      "required": [
        "verdict_requirements",
        "required_metadata",
        "evidence_source_by_phase"
      ]
    },
    "reviewers": {
      "$ref": "https://specdev.local/schema/core/collections/1#stringArray"
    },
    "trace": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#traceRef"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#link"
      }
    },
    "generation_quality": {
      "$ref": "https://specdev.local/schema/core/collections/1#/$defs/generationQuality"
    },
    "canonical_refs_used": {
      "$ref": "https://specdev.local/schema/core/collections/1#/$defs/canonicalRefArray"
    },
    "canonical_proposals": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#/$defs/canonicalProposal"
      },
      "default": []
    },
    "canonical_conflicts": {
      "type": "array",
      "items": {
        "$ref": "https://specdev.local/schema/core/collections/1#/$defs/canonicalConflict"
      },
      "default": []
    },
    "policy_ref": {
      "$ref": "https://specdev.local/schema/core/collections/1#/$defs/canonicalRef"
    },
    "command_ref": {
      "$ref": "https://specdev.local/schema/core/collections/1#/$defs/canonicalRef"
    },
    "_migration_notes": {
      "type": "string",
      "description": "Optional migration notes added during schema version upgrades."
    }
  },
  "required": [
    "id",
    "owner",
    "created_at",
    "seed_refs",
    "spec_refs_ingested",
    "spec_first_policy",
    "commit_message_rules",
    "generation_quality",
    "canonical_refs_used",
    "canonical_proposals",
    "canonical_conflicts"
  ]
}
