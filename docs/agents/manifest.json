{
  "name": "specdev-agent-guide",
  "version": "1.2.0",
  "entrypoint": "docs/agents/agents.md",
  "description": "Operational contract for AI agents working with the AI Spec Driven Development Toolkit",
  "interaction_mode": "two_phase",
  "modes": {
    "clarify": {
      "purpose": "Collect missing, high-impact details before artifact emission.",
      "output_contract": {
        "type": "questions",
        "format": "markdown_bullets_only",
        "restrictions": [
          "Do not emit JSON or code fences"
        ]
      }
    },
    "emit": {
      "purpose": "Generate the canonical JSON artifact.",
      "output_contract": {
        "type": "json_artifact",
        "fenced_code_block": true,
        "language": "json",
        "restrictions": [
          "Exactly one fenced json block"
        ]
      }
    }
  },
  "step_config": {
    "14": {
      "mode": "one_shot",
      "artifact": "spec/14_roadmap.json",
      "schema": "14_roadmap"
    },
    "16a": {
      "mode": "one_shot",
      "artifact": "spec/impl_context/{step_id}.json",
      "schema": "16_impl_context"
    },
    "16b": {
      "mode": "loop",
      "artifact": "spec/impl_context/{step_id}.json",
      "schema": "16_impl_context"
    },
    "16c": {
      "mode": "one_shot",
      "artifact": "spec/impl_context/{step_id}.json",
      "schema": "16_impl_context"
    }
  },
  "phase_triggers": {},
  "commands": [
    "See docs/developers/reference.md"
  ],
  "changelog": [
    {
      "version": "1.3.0",
      "date": "2025-01-12",
      "changes": [
        "Consolidated Steps 16a-d into Trinity Loop (16a-c)",
        "Retired Steps 17, 18, 19 (Merged into Trinity)"
      ]
    },
    {
      "version": "1.2.0",
      "date": "2025-01-12",
      "changes": [
        "Added Steps 16a-d for Agentic Implementation Loop"
      ]
    },
    {
      "version": "1.1.0",
      "date": "2024-05-20",
      "changes": [
        "Added Heuristics For Completeness"
      ]
    }
  ]
}